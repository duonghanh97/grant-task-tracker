{
  "ConnectionStrings": {
    "GrantTracker": "Data Source=granttracker.db"
  },
  "Database": {
    "ResetOnStartup": false,
    "Seed": true
  },
  "Business": {
    "UtcOffset": "+00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
